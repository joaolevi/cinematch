CINEMATCH_DATABASE_URL=sqlite:///./cinematch.db
CINEMATCH_SECRET_KEY=troque-esta-chave-por-uma-string-longa-e-aleatoria
CINEMATCH_TOKEN_EXPIRE_MINUTES=1440
CINEMATCH_AUTO_SEED=true
# Origens liberadas no CORS (endereço onde o frontend roda), separadas por vírgula
CINEMATCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TMDB (opcional) — chave gratuita em https://www.themoviedb.org/settings/api
# Sem chave, a sincronização usa o catálogo mockado. NUNCA commite a chave real.
CINEMATCH_TMDB_API_KEY=
CINEMATCH_TMDB_LANGUAGE=pt-BR
CINEMATCH_TMDB_REGION=BR
CINEMATCH_TMDB_SYNC_PAGES=2
