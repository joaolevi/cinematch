TASTORY_DATABASE_URL=sqlite:///./tastory.db
TASTORY_SECRET_KEY=troque-esta-chave-por-uma-string-longa-e-aleatoria
TASTORY_TOKEN_EXPIRE_MINUTES=1440
TASTORY_AUTO_SEED=true
# Origens liberadas no CORS (endereço onde o frontend roda), separadas por vírgula
TASTORY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TMDB (opcional) — chave gratuita em https://www.themoviedb.org/settings/api
# Sem chave, a sincronização usa o catálogo mockado. NUNCA commite a chave real.
TASTORY_TMDB_API_KEY=
TASTORY_TMDB_LANGUAGE=pt-BR
TASTORY_TMDB_REGION=BR
TASTORY_TMDB_SYNC_PAGES=2
