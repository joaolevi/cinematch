# Copie para .env.production e preencha. Esse arquivo fica só no servidor, fora do git.

# Endereços públicos. Sem barra no final.
TASTORY_PUBLIC_URL=https://seu-servidor.ts.net
TASTORY_API_URL=https://seu-servidor.ts.net:8443

# Gere cada um com: openssl rand -hex 32
POSTGRES_PASSWORD=
TASTORY_SECRET_KEY=

# Senhas das contas iniciais, diferentes das que aparecem no README
TASTORY_ADMIN_PASSWORD=
TASTORY_DEMO_PASSWORD=
TASTORY_SYNTHETIC_PASSWORD=

# Catálogo
TASTORY_TMDB_API_KEY=
TASTORY_TMDB_SYNC_PAGES=10
